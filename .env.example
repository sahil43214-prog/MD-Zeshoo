DASHBOARD_ORIGIN=https://your-app.up.railway.app
# Optional bot integrations
OPENAI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-5-mini
GEMINI_API_KEY=
OMDB_API_KEY=
GITHUB_TOKEN=
AUTH_DIR=./auth_info
